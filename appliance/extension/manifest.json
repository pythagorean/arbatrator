{
  "manifest_version": 3,
  "name": "Arbatrate media handoff",
  "version": "0.1.0",
  "description": "Offers to play media from this remote browser in a player on your own machine. Protected (DRM) media stays in the browser.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Play this page's media locally" },
  "icons": { "128": "icon128.png" }
}
